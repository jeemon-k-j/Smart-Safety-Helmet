# Smart Safety Helmet local email bridge — DEVELOPMENT ONLY.
# Copy to `.env` (git-ignored) or set in your shell. NEVER commit real values.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3000

# Fallback recipient when the app payload has no emergency contact emails.
TEST_EMAIL=developer-controlled-test@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@example.com
SMTP_PASSWORD=your-app-password
