# Smart Safety Helmet local email bridge — DEVELOPMENT ONLY.
# Copy to `.env` (git-ignored). NEVER commit real values.
#
#   copy .env.example .env
#   npm start
#
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3000

# Single emergency inbox for all accident emails from this bridge.
EMERGENCY_RECIPIENT=emergency-recipient@example.com
# Optional alias (same meaning as EMERGENCY_RECIPIENT):
# TEST_EMAIL=emergency-recipient@example.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@example.com
# Gmail App Password (prefer SMTP_PASSWORD; SMTP_PASS also accepted)
SMTP_PASSWORD=your-app-password
# SMTP_PASS=your-app-password
