{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        "status": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['alcoholDetected', 'helmetClipped', 'ignitionAllowed', 'ignitionActive', 'drowsy', 'warningActive'])"
        },
        "accident": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['eventId', 'active', 'severity'])"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "emergencyContacts": {
          "$contactId": {
            ".validate": "newData.hasChildren(['name', 'email']) && newData.child('email').isString()"
          }
        },
        "linkedDeviceId": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
